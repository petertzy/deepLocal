{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deepLocal",
  "version": "0.1.0",
  "identifier": "dev.deeplocal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "deepLocal",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI workbench for GGUF models",
    "longDescription": "deepLocal helps users download, manage, chat with, and serve local GGUF models.",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": [],
    "resources": {
      "resources/llama-runtime": "llama-runtime"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "$TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/petertzy/deepLocal/releases/latest/download/latest.json"
      ]
    }
  }
}
